{
  "expo": {
    "name": "CampusConnect",
    "slug": "Spotlight",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/splash/image2.png",

    "scheme": "spotlight",
    "userInterfaceStyle": "automatic",

    "splash": {
      "image": "./assets/splash/image2.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vir567.Spotlight",
      "buildNumber": "1",
      "googleServicesFile": "./firebase/GoogleService-Info.plist"
    },

    "android": {
      "package": "com.vir567.Spotlight",
      "versionCode": 2,
      "googleServicesFile": "./firebase/google-services.json",
      "permissions": ["NOTIFICATIONS"],

      "adaptiveIcon": {
        "foregroundImage": "./assets/splash/image2.png",
        "backgroundColor": "#ffffff"
      },

      "softwareKeyboardLayoutMode": "pan",
      "edgeToEdgeEnabled": false
    },

    "plugins": [
      "expo-router",

      [
        "expo-notifications",
        {
          "icon": "./assets/notification/icon.png",
          "color": "#0EA5E9"
        }
      ],

      "expo-splash-screen",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",

      "@react-native-firebase/app",
      "@react-native-firebase/messaging"
    ],

    "experiments": {
      "typedRoutes": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "bfeea64c-946c-4d50-8b0c-9e0d0d495f52"
      }
    },

    "runtimeVersion": "1.0.0",

    "updates": {
      "fallbackToCacheTimeout": 0
    }
  }
}
