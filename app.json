{
  "expo": {
    "name": "CampusConnect",
    "slug": "Spotlight",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/splash/image2.png",
    "scheme": "spotlight",
    "userInterfaceStyle": "automatic",

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vir567.Spotlight",
      "buildNumber": "1"
    },

    "android": {
      "package": "com.vir567.Spotlight",
      "versionCode": 2,
      "useNextNotificationsApi": true,
      "permissions": ["NOTIFICATIONS"],

      "googleServicesFile": "./firebase/google-services.json",

      "adaptiveIcon": {
        "foregroundImage": "./assets/splash/image2.png",
        "backgroundColor": "#ffffff"
      },
      "softwareKeyboardLayoutMode": "pan",
      "edgeToEdgeEnabled": false
    },

    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",

      [
        "expo-notifications",
        {
          "icon": "./assets/notification.png",
          "color": "#ffffff"
        }
      ],

      "expo-splash-screen",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",

      "@react-native-firebase/app",
      "@react-native-firebase/messaging"
    ],

    "experiments": {
      "typedRoutes": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "bfeea64c-946c-4d50-8b0c-9e0d0d495f52"
      }
    },

    "runtimeVersion": "1.0.0",

    "updates": {
      "url": "https://u.expo.dev/bfeea64c-946c-4d50-8b0c-9e0d0d495f52",
      "fallbackToCacheTimeout": 0
    }
  }
}
