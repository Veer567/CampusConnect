{
  "expo": {
    "name": "CampusConnect",
    "slug": "Spotlight",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",

    /* 🚫 Neutralize Expo default splash */
    "splash": {
      "backgroundColor": "#ffffff",
      "image": "./assets/transparent.png",
      "resizeMode": "contain"
    },

    /* 📱 App Icon */
    "icon": "./assets/splash/image2.png",

    /* 🔗 Deep linking */
    "scheme": "spotlight",

    /* ───────────────── iOS ───────────────── */
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vir567.Spotlight",
      "buildNumber": "1",
      "googleServicesFile": "./firebase/GoogleService-Info.plist"
    },

    /* ───────────────── Android ───────────────── */
    "android": {
      "package": "com.vir567.Spotlight",
      "versionCode": 2,
      "userInterfaceStyle": "light",
      "googleServicesFile": "./firebase/google-services.json",

      "permissions": ["NOTIFICATIONS"],

      /* 🟢 Android 12+ native splash uses this */
      "adaptiveIcon": {
        "foregroundImage": "./assets/splash/image2.png",
        "backgroundColor": "#ffffff"
      },

      "softwareKeyboardLayoutMode": "resize",
      "edgeToEdgeEnabled": false
    },

    /* ───────────────── Plugins ───────────────── */
    "plugins": [
      "./plugins/disableForceDark",
      "expo-router",

      [
        "expo-notifications",
        {
          "icon": "./assets/notification/icon.png",
          "color": "#0EA5E9"
        }
      ],

      "expo-secure-store",
      "expo-font",
      "expo-web-browser",

      "@react-native-firebase/app",
      "@react-native-firebase/messaging"
    ],

    /* 🧪 Experiments */
    "experiments": {
      "typedRoutes": true
    },

    /* 🔄 OTA Updates */
    "updates": {
      "fallbackToCacheTimeout": 0
    },

    /* 🧩 Runtime */
    "runtimeVersion": "1.0.0",

    /* 📦 Extra */
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bfeea64c-946c-4d50-8b0c-9e0d0d495f52"
      }
    }
  }
}
